{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Load Combination Generator",
  "description": "Generate load combinations for all major design standards.",
  "type": "object",
  "properties": {
    "region_input": {
      "type": "string",
      "description": "Region. The S3D UI sends this as 'country_input' instead; both are accepted.",
      "enum": [
        "australia",
        "united-states",
        "new-zealand",
        "europe",
        "canada",
        "india"
      ],
      "x-enumLabels": [
        "Australia",
        "United States",
        "New Zealand",
        "Europe",
        "Canada",
        "India"
      ],
      "default": "united-states"
    },
    "standard_input": {
      "type": "string",
      "description": "Standard. Must be the calculator's id. 'Please Select' crashes. NZ has no separate id: the S3D UI sends country_input 'australia' + standard_input 'AS-1170.0-2002' when New Zealand is selected (captured live 2026-09-23); 'AS/NZS-1170.0-2002' fails here even though it's the model/UI code id. The S3D UI also offers ASCE-7-2016-LRFD/ASD, NBCC-2015 and IS-456-2000 (untested here).",
      "enum": [
        "ASCE-7-2022-LRFD",
        "ASCE-7-2022-ASD",
        "AS-1170.0-2002",
        "NBCC-2020",
        "EN-1990-2002",
        "IS-800-2007"
      ],
      "x-enumLabels": [
        "ASCE-7-2022-LRFD",
        "ASCE-7-2022-ASD",
        "AS-1170.0-2002",
        "NBCC-2020",
        "EN-1990-2002",
        "IS-800-2007"
      ],
      "default": "ASCE-7-2022-LRFD"
    },
    "criteria_input": {
      "type": "string",
      "description": "Criteria. Symbol: Criteria",
      "enum": [
        "All"
      ],
      "x-enumLabels": [
        "All"
      ],
      "default": "All"
    },
    "combination_naming_input": {
      "type": "string",
      "description": "Combination Naming. Symbol: Naming",
      "enum": [
        "ID",
        "ID + Criteria",
        "ID + Factor + Symbol",
        "ID + Factor + Name",
        "Schema Row + Increment"
      ],
      "x-enumLabels": [
        "ID",
        "ID + Criteria",
        "ID + Factor + Symbol",
        "ID + Factor + Name",
        "Schema Row + Increment"
      ],
      "default": "ID"
    },
    "multi_dropdown_1": {
      "type": "string",
      "description": "Filter 01 (favourable/unfavourable dead). REQUIRED - omitting it crashes with \"reading 'split'\". Use \",f,u\".",
      "enum": [
        ",f,u"
      ],
      "x-enumLabels": [
        ",f,u"
      ]
    },
    "multi_dropdown_2": {
      "type": "string",
      "description": "Filter 02. AS/NZS: \",sta,str\" (stability, strength). Europe: comma list of setA1,setB1,setC,seis."
    },
    "multi_dropdown_3": {
      "type": "string",
      "description": "Filter 03. Europe SLS: \",cha,fre,qua\" (characteristic, frequent, quasi-permanent)."
    },
    "multi_dropdown_4": {
      "type": "string",
      "description": "Filter 04. Symbol: Filter-04",
      "enum": [
        null
      ],
      "x-enumLabels": [
        "undefined"
      ]
    },
    "load_case_table": {
      "type": "array",
      "description": "Load Cases",
      "items": {
        "type": "object",
        "properties": {
          "col1": {
            "type": "string",
            "description": "Load Case symbol for the chosen standard (e.g. D, L, Lr, S, W, Eh for ASCE; G, Qdo, Wu, Ws, Su, Eu, Es for AS 1170.0). See load-combinations/SKILL.md for each code's list.",
            "default": "D"
          },
          "col2": {
            "type": "string",
            "description": "Quantity",
            "default": 1,
            "minimum": 1,
            "maximum": 10
          },
          "col3": {
            "type": "string",
            "description": "Pattern when col2 > 1: 'independent' = one group per combination (use for wind/seismic directions); 'simultaneous' = all groups together in every combination.",
            "default": "simultaneous",
            "enum": [
              "simultaneous",
              "independent",
              "mirror",
              "paired",
              "sweep",
              "checker"
            ]
          },
          "col4": {
            "type": "number",
            "description": "Main Ratio",
            "default": 1
          },
          "col5": {
            "type": "number",
            "description": "Alternate Ratio",
            "default": 0.5
          },
          "col6": {
            "type": "string",
            "description": "Comma-separated group names, one per col2 (e.g. 'D1,SW1' with col2 = 2), or 'auto' for D1, W1, W2... Names come back in each group's 'label'.",
            "default": "auto"
          }
        }
      }
    },
    "remove_unnecessary": {
      "type": "boolean",
      "description": "Remove Unnecessary. Symbol: Toggle",
      "default": true
    },
    "uid": {
      "type": "string",
      "const": "7000-load-combination-generator",
      "description": "Calculator unique identifier \u00e2\u20ac\u201d must match the endpoint uid."
    },
    "current_unit_system": {
      "type": "string",
      "enum": [
        "metric",
        "imperial",
        ""
      ],
      "default": "metric",
      "description": "Unit system for input values and output display."
    },
    "project_details": {
      "type": "object",
      "description": "Optional project metadata for the PDF report header.",
      "properties": {
        "project_company": {
          "type": "string",
          "default": ""
        },
        "project_name": {
          "type": "string",
          "default": ""
        },
        "project_designer": {
          "type": "string",
          "default": ""
        },
        "project_id": {
          "type": "string",
          "default": ""
        },
        "project_client": {
          "type": "string",
          "default": ""
        },
        "project_notes": {
          "type": "string",
          "default": ""
        }
      }
    }
  }
}